# Backend Environment Variables (FastAPI)
# Copy this file to .env in the backend directory:
#   cp .env.example .env

# --- Supabase Credentials ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Optional Direct PostgreSQL Credentials ---
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password

# --- Redis Cache Configuration ---
REDIS_URL=redis://localhost:6379/0

# --- Admin API Key (For /api/cache/warm/{user_id}) ---
ADMIN_KEY=synergy_admin_secure_key_123

# --- External Services (Optional: deterministic fallbacks trigger if absent) ---
NEWSAPI_KEY=your-newsapi-key-here
ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here
